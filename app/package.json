{
  "name": "cuby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CUBY: juego físico-digital y luces para el cubo de LEDs (ESP32 + MPU6050 + 293 WS2812B)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "parity": "sh tools/parity/run.sh",
    "firmware:bundle": "sh tools/bundle-firmware.sh"
  },
  "dependencies": {
    "@fontsource/sora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "~4.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-react": "~5.2.0",
    "tailwindcss": "~4.3.0",
    "typescript": "~5.9.3",
    "vite": "~7.3.0",
    "vitest": "~3.2.0"
  }
}
